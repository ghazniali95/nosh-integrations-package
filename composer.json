{
    "name": "nosh/omniconnect",
    "description": "OmniConnect — a Laravel package for integrating a restaurant/POS system with foodpanda (Delivery Hero's POS Integration Middleware). It is two-directional: it CALLS Delivery Hero to accept/reject orders, mark them prepared, push menus and toggle store/item availability, and it RECEIVES orders and updates from Delivery Hero over a mountable Plugin API (signed webhooks) that it normalizes and hands to your app. Platform-driven, multi-tenant, and extensible to further delivery platforms by design. A Nosh (RapidFlow) package.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "omniconnect", "foodpanda", "delivery-hero", "pos", "integration-middleware", "orders", "catalog", "pakistan", "food-delivery"],
    "authors": [
        { "name": "Nosh", "homepage": "https://noshpk.com" }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/bus": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/queue": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nosh\\OmniConnect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nosh\\OmniConnect\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nosh\\OmniConnect\\OmniConnectServiceProvider"
            ],
            "aliases": {
                "OmniConnect": "Nosh\\OmniConnect\\Facades\\OmniConnect"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
